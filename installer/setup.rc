// IN1: the installer's manifest (common controls 6, DPI aware, no elevation)
// and version information.
#include <winresrc.h>

1 24 "setup.manifest"   // 24 = RT_MANIFEST

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 3,0,0,0
 PRODUCTVERSION 3,0,0,0
 FILEOS VOS_NT_WINDOWS32
 FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "davidm71"
            VALUE "FileDescription", "Atomic MGPU Bridge - Setup"
            VALUE "FileVersion", "3.0"
            VALUE "ProductName", "Atomic MGPU Bridge"
            VALUE "ProductVersion", "3.0"
            VALUE "LegalCopyright", "MIT licence - a fork of MGPU Bridge by Marcelo Guibout"
            VALUE "OriginalFilename", "AtomicMGPU-Setup.exe"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
